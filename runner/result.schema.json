{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.8005-agv.local/wire-to-gate/v1/runner/result.schema.json",
  "title": "Conformance result",
  "type": "object",
  "properties": {
    "runId": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Id"
    },
    "integrationSliceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^W2G-IS-0[0-7]$"
    },
    "runKind": {
      "type": "string",
      "enum": [
        "G1",
        "CONTROL_SERVER_G2",
        "ONBOARD_HMI_G2",
        "G3"
      ]
    },
    "protocolManifestSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "controlServerCommit": {
      "anyOf": [
        {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/CommitSha"
        },
        {
          "type": "null"
        }
      ]
    },
    "onboardHmiCommit": {
      "anyOf": [
        {
          "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/CommitSha"
        },
        {
          "type": "null"
        }
      ]
    },
    "fakePeerIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/CommitSha"
          },
          "artifactSha256": {
            "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
          },
          "harnessContractVersion": {
            "type": "string",
            "minLength": 1
          },
          "supportedIntegrationSliceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^W2G-IS-0[0-7]$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "repository",
          "commit",
          "artifactSha256",
          "harnessContractVersion",
          "supportedIntegrationSliceIds"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "vectorIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "vectorsSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "virtualTimeScriptSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "configurationSha256": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Sha256"
    },
    "startedAt": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
    },
    "finishedAt": {
      "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/Instant"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "firstDivergence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "actual": {
              "type": "string",
              "minLength": 1
            },
            "stableErrorCode": {
              "anyOf": [
                {
                  "$ref": "https://schemas.8005-agv.local/wire-to-gate/v1/common/types.schema.json#/$defs/ErrorCode"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "step",
            "expected",
            "actual",
            "stableErrorCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidencePointers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "runId",
    "integrationSliceId",
    "runKind",
    "protocolManifestSha256",
    "controlServerCommit",
    "onboardHmiCommit",
    "fakePeerIdentities",
    "vectorIds",
    "vectorsSha256",
    "virtualTimeScriptSha256",
    "configurationSha256",
    "startedAt",
    "finishedAt",
    "result",
    "firstDivergence",
    "evidencePointers"
  ],
  "additionalProperties": false
}
